  unless phase_daze

verb vuln_timer_clears "The head lies stunned, face cracked open is over" by world priority 100 in enemy at 2180 640
  take timer_vuln
  unless phase_vuln

verb burrow_open_timer_clears "The stunned head sinks back, face still open is over" by world priority 100 in enemy at 2040 780
  take timer_burrow_open
  unless phase_burrow_open

verb damaged_timer_clears "The head reels from the blow and sinks away is over" by world priority 100 in enemy at 2180 850
  take timer_damaged
  unless phase_damaged

