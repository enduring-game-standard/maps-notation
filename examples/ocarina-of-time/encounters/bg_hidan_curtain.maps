maps 2
title "Ocarina of Time combat: Link vs Fire Temple fire ring"

seat link "Link" color "#3a7d44"
group setup "setup"
group beat "beat"
group range "range"
group link_state "link state"
group outcomes "outcomes"
group gear "gear"
group enemy "enemy"
group link_moves "link moves"
group hits "hits"
group attacks "attacks"

