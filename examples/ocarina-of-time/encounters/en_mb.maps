verb guard_look_timer_clears "Spear Moblin looks around is over" by world priority 100 in enemy at 2040 150
  take timer_guard_look
  unless phase_guard_look

verb guard_walk_cooldown_timer_clears "Spear Moblin wanders after a charge is over" by world priority 100 in enemy at 2040 290
  take timer_guard_walk_cooldown
  unless phase_guard_walk_cooldown

verb stunned_guard_timer_clears "Spear Moblin is stunned is over" by world priority 100 in enemy at 2040 500
  take timer_stunned_guard
  unless phase_stunned_guard

verb patrol_turn_timer_clears "Patrol Moblin turns to its next waypoint is over" by world priority 100 in enemy at 2180 570
  take timer_patrol_turn
  unless phase_patrol_turn

verb patrol_end_charge_timer_clears "Patrol Moblin lands and eyes Link is over" by world priority 100 in enemy at 2040 780
