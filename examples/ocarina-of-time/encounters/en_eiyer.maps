verb glide_timer_clears "Stinger glides above the floor is over" by world priority 99 in enemy at 2180 220
  take timer_glide
  unless phase_glide

verb land_timer_clears "Stinger plunges back into the floor is over" by world priority 99 in enemy at 2180 360
  take timer_land
  unless phase_land

verb hurt_timer_clears "Stinger reels from a hit is over" by world priority 99 in enemy at 2040 500
  take timer_hurt
  unless phase_hurt

verb stunned_timer_clears "Stinger is stunned is over" by world priority 99 in enemy at 2180 570
  take timer_stunned
  unless phase_stunned

