verb wait_timer_clears "Freezard hides in the ice is over" by world priority 100 in enemy at 2040 150
  take timer_wait
  unless phase_wait

verb appear_timer_clears "Freezard rises out of the ice is over" by world priority 100 in enemy at 2180 220
  take timer_appear
  unless phase_appear

verb aim_move_timer_clears "Freezard turns toward Link is over" by world priority 100 in enemy at 2040 360
  take timer_aim_move
  unless phase_aim_move

verb aim_freeze_timer_clears "Freezard turns to breathe on Link is over" by world priority 100 in enemy at 2040 500
  take timer_aim_freeze
  unless phase_aim_freeze

verb blow_timer_clears "Freezard breathes freezing mist is over" by world priority 100 in enemy at 2180 570
  take timer_blow
  unless phase_blow

verb still_turn_timer_clears "Rooted Freezard turns toward Link is over" by world priority 100 in enemy at 2180 710
  take timer_still_turn
  unless phase_still_turn

verb still_blow_timer_clears "Rooted Freezard breathes freezing mist is over" by world priority 100 in enemy at 2040 850
  take timer_still_blow
  unless phase_still_blow

