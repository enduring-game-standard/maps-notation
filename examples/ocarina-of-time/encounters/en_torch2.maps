verb fading_timer_clears "Dark Link duels, still translucent is over" by world priority 100 in enemy at 2180 150
  take timer_fading
  unless phase_fading

verb stunned_faint_timer_clears "Translucent Dark Link is frozen by a Deku Nut is over" by world priority 100 in enemy at 2180 290
  take timer_stunned_faint
  unless phase_stunned_faint

verb stunned_timer_clears "Dark Link is frozen by a Deku Nut is over" by world priority 100 in enemy at 2040 430
  take timer_stunned
  unless phase_stunned

