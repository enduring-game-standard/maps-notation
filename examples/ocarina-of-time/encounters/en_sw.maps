verb fairy_revives_link "A bottled fairy revives Link" by world priority 90 in link_state at 1220 640
  need in_fight
  unless link_hp
  take has_fairy
  give 8 link_heal

verb link_fell "Link falls" by world priority 89 in outcomes at 1540 150
  need in_fight
  unless link_hp
  unless has_fairy
  give link_falls

verb body_hurt "Skulltula loses health" by world priority 96 in enemy_health at 2500 150
  take dmg_body
  take hp_body

verb body_overkill "Skulltula has no health left to lose" by world priority 95 in enemy_health at 2360 220
  take dmg_body
  unless hp_body

