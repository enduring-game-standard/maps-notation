verb floor_main_patient_timer_clears "Gohma stalks Link on the floor, eye open is over" by world priority 100 in enemy at 2040 150
  take timer_floor_main_patient
  unless phase_floor_main_patient

verb rest_timer_clears "Gohma rests after her swipe, eye red is over" by world priority 100 in enemy at 2180 290
  take timer_rest
  unless phase_rest

verb stunned_nut_timer_clears "Gohma reels from a Deku Nut, patience left is over" by world priority 100 in enemy at 2040 430
