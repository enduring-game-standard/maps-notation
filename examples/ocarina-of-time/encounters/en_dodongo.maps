verb idle_timer_clears "Dodongo stands still is over" by world priority 99 in enemy at 2040 150
  take timer_idle
  unless phase_idle

verb idle_short_timer_clears "Dodongo pauses after breathing fire is over" by world priority 99 in enemy at 2180 220
  take timer_idle_short
  unless phase_idle_short

verb walk_timer_clears "Dodongo walks is over" by world priority 99 in enemy at 2040 360
