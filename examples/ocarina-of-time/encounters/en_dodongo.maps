  unless phase_sweep

verb stunned_timer_clears "Dodongo is stunned is over" by world priority 99 in enemy at 2180 640
  take timer_stunned
  unless phase_stunned

verb swallow_timer_clears "Dodongo swallows a bomb is over" by world priority 99 in enemy at 2040 780
  take timer_swallow
  unless phase_swallow

