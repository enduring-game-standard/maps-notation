verb variant_standing "Red flame that burns in place (params bit 15 clear)" by world priority 30 in setup at 260 500
  take choose_variant
  give phase_launch_still
  give range_far
  give link_turn

verb link_heals "Link heals" by world priority 99 in link_state at 1080 500
  take link_heal
  take link_missing
  give link_hp

verb link_heal_overflows "Link is at full health" by world priority 99 in link_state at 1220 500
  take link_heal
  unless link_missing

verb magic_refills "Magic refills" by world priority 98 in link_state at 1080 570
  take magic_refill
  take magic_spent
  give magic

verb magic_refill_overflows "Magic is full" by world priority 98 in link_state at 1220 570
  take magic_refill
  unless magic_spent

verb link_hurt "Link loses health" by world priority 95 in link_state at 1080 640
  take link_dmg
  take link_hp
  give link_missing

verb link_hurt_overkill "Link has no health left to lose" by world priority 94 in link_state at 1220 640
  take link_dmg
  unless link_hp

verb fairy_revives_link "A bottled fairy revives Link" by world priority 92 in link_state at 1080 710
  need in_fight
  unless link_hp
  take has_fairy
  give 16 link_heal

verb link_fell "Link falls" by world priority 91 in outcomes at 1540 150
  need in_fight
  unless link_hp
  unless has_fairy
  give link_falls

verb flame_hurt "Flame loses health" by world priority 97 in enemy_health at 2500 150
  take dmg_flame
  take hp_flame

verb flame_overkill "Flame has no health left to lose" by world priority 96 in enemy_health at 2360 220
  take dmg_flame
  unless hp_flame

verb link_deku_nut "Deku Nut thrown; on impact it spawns En_M_Fire1, a 200-radius flash cylinder carrying DMG_DEKU_NUT" by link in link_moves at 2680 80
