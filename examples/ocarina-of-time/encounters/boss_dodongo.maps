  take phase_getup
  give phase_roll
  give timer_roll
  give beat_end

verb damaged_step_1 "King Dodongo rolls" by world priority 69 in enemy at 2180 1480
  take enemy_act
  take phase_damaged
  give phase_roll
  give timer_roll
  give beat_end

verb roll_ticks "King Dodongo curls up and rolls around the arena: a beat passes" by world priority 71 in enemy at 2040 1550
  take enemy_turn
  need phase_roll
  take timer_roll
  give enemy_act

verb roll_step_1 "King Dodongo rolls over Link" by world priority 69 in enemy at 2180 1550
  take enemy_act
  take phase_roll
  give phase_walk_free
  unless timer_roll
  give incoming_roll
  give beat_end
  need range_near

verb roll_step_2 "King Dodongo rolls into the wall" by world priority 69 in enemy at 2040 1620
  take enemy_act
  take phase_roll
  give phase_walk_free
  unless timer_roll
  give beat_end
  need range_far

verb roll_blocked_deku_shield "King Dodongo rolls into Link: blocked by the deku shield" by world priority 60 in attacks at 3460 80
  take incoming_roll
  need guard_with_deku_shield

verb roll_blocked_hylian_shield "King Dodongo rolls into Link: blocked by the hylian shield" by world priority 60 in attacks at 3320 150
  take incoming_roll
  need guard_with_hylian_shield

verb roll_dodged "King Dodongo rolls into Link: dodged" by world priority 60 in attacks at 3460 150
  take incoming_roll
  need link_dodge
  unless link_guard

verb roll_nayru "King Dodongo rolls into Link: Nayru's Love holds" by world priority 60 in attacks at 3320 220
  take incoming_roll
  need status_nayru
  unless link_guard
  unless link_dodge

verb roll_lands "King Dodongo rolls into Link hits Link" by world priority 60 in attacks at 3460 220
  take incoming_roll
  unless link_guard
  unless link_dodge
  unless status_nayru
  give 4 link_dmg

verb fire_dodged "Fire breath: dodged" by world priority 60 in attacks at 3460 290
  take incoming_fire
  need link_dodge

verb fire_nayru "Fire breath: Nayru's Love holds" by world priority 60 in attacks at 3320 360
  take incoming_fire
  need status_nayru
  unless link_dodge

verb fire_lands "Fire breath hits Link" by world priority 60 in attacks at 3460 360
  take incoming_fire
  unless link_dodge
  unless status_nayru
  give 8 link_dmg
  give 5 status_burn
  unless status_burn

verb fire_lands_again "Fire breath hits Link again" by world priority 60 in attacks at 3320 430
  take incoming_fire
  unless link_dodge
  unless status_nayru
  give 8 link_dmg
  need status_burn

verb link_lowers_shield "Link lowers his shield" by world priority 50 in beat at 440 220
  need beat_end
  take link_guard

verb link_lowers_deku_shield "Link lowers the deku shield" by world priority 50 in beat at 580 220
  need beat_end
  take guard_with_deku_shield

verb link_lowers_hylian_shield "Link lowers the hylian shield" by world priority 50 in beat at 440 290
  need beat_end
  take guard_with_hylian_shield

verb link_lands "Link lands from his dodge" by world priority 50 in beat at 580 290
  need beat_end
  take link_dodge

verb burn_ticks "Link: burn wears on" by world priority 48 in beat at 580 430
  take beat_end
  take status_burn
  unless burn_count
  give burn_count
  give tick_burn

verb burn_costs "Link: burn takes its toll" by world priority 48 in beat at 440 500
  take beat_end
  take status_burn
  take burn_count
  give tick_burn
  give 5 link_dmg

verb burn_count_clears "Link: burn count resets" by world priority 99 in beat at 580 500
  take burn_count
  unless status_burn

verb burn_idle "Link: no burn" by world priority 48 in beat at 440 570
  take beat_end
  unless status_burn
  give tick_burn

verb nayru_ticks "Link: nayru wears on" by world priority 47 in beat at 580 570
  take tick_burn
  take status_nayru
  give tick_nayru

verb nayru_idle "Link: no nayru" by world priority 47 in beat at 440 640
  take tick_burn
  unless status_nayru
  give tick_nayru

verb lens_ticks "The Lens wears on" by world priority 46 in beat at 440 710
  take tick_nayru
  need lens_on
  need magic
  unless 3 lens_count
  give lens_count
  give link_turn

verb lens_costs "The Lens takes its toll" by world priority 46 in beat at 580 710
  take tick_nayru
  need lens_on
  need magic
  take 3 lens_count
  give link_turn
  take magic
  give magic_spent

verb lens_fades "The Lens runs out of magic" by world priority 46 in beat at 440 780
  take tick_nayru
  take lens_on
  unless magic
  give link_turn

verb lens_idle "The Lens is off" by world priority 46 in beat at 580 780
  take tick_nayru
  unless lens_on
  give link_turn

verb lens_count_clears "The Lens count resets" by world priority 99 in beat at 440 850
  take lens_count
  unless lens_on
