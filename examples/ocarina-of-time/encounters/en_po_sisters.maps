verb circle_meg_timer_clears "Meg and her illusions circle Link is over" by world priority 99 in enemy at 2040 220
  take timer_circle_meg
  unless phase_circle_meg

verb vanish_meg_timer_clears "Meg is gone, and returns beside Link is over" by world priority 99 in enemy at 2040 430
  take timer_vanish_meg
  unless phase_vanish_meg

verb roam_hidden_timer_clears "The sister roams and strikes unseen; only a Deku Nut or magic touches her is over" by world priority 99 in enemy at 2180 920
  take timer_roam_hidden
  unless phase_roam_hidden

