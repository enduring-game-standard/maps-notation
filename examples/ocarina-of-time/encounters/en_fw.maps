verb variant_more "The Flare Dancer has more than 8 health: a drained core costs it 8 and runs home" by world priority 30 in setup at 120 500
  take choose_variant
  give phase_bounce_more
  give range_far
  give link_turn

verb variant_last "The Flare Dancer has 8 health or less: draining the core finishes it" by world priority 30 in setup at 260 500
  take choose_variant
  give phase_bounce_last
  give range_far
  give link_turn

verb link_heals "Link heals" by world priority 98 in link_state at 1220 430
  take link_heal
  take link_missing
  give link_hp

verb link_heal_overflows "Link is at full health" by world priority 98 in link_state at 1080 500
  take link_heal
  unless link_missing

verb magic_refills "Magic refills" by world priority 97 in link_state at 1220 500
  take magic_refill
  take magic_spent
  give magic

verb magic_refill_overflows "Magic is full" by world priority 97 in link_state at 1080 570
  take magic_refill
  unless magic_spent

verb link_hurt "Link loses health" by world priority 94 in link_state at 1220 570
  take link_dmg
  take link_hp
  give link_missing

verb link_hurt_overkill "Link has no health left to lose" by world priority 93 in link_state at 1080 640
  take link_dmg
  unless link_hp

verb fairy_revives_link "A bottled fairy revives Link" by world priority 90 in link_state at 1220 640
  need in_fight
  unless link_hp
  take has_fairy
  give link_heal

verb link_fell "Link falls" by world priority 89 in outcomes at 1540 150
  need in_fight
  unless link_hp
  unless has_fairy
  give link_falls

verb core_more_hurt "Core loses health" by world priority 96 in enemy_health at 2360 290
  take dmg_core_more
  take hp_core_more

verb core_more_overkill "Core has no health left to lose" by world priority 95 in enemy_health at 2500 290
  take dmg_core_more
  unless hp_core_more

verb core_last_hurt "Last core loses health" by world priority 96 in enemy_health at 2360 360
  take dmg_core_last
  take hp_core_last

verb core_last_overkill "Last core has no health left to lose" by world priority 95 in enemy_health at 2500 360
  take dmg_core_last
  unless hp_core_last

