maps 2
title "Ocarina of Time combat: Link vs Flare Dancer's core"

seat link "Link" color "#3a7d44"
group setup "setup"
group beat "beat"
group range "range"
group link_state "link state"
group outcomes "outcomes"
group gear "gear"
group enemy "enemy"
group enemy_health "enemy health"
group link_moves "link moves"
group hits "hits"

state choose_age "Link sets out" marks 1 in setup at 120 80
state age_adult "Link is an adult" in setup at 260 80
state choose_variant "Which Flare Dancer's core" in setup at 120 150
state link_turn "Link's move" in beat at 440 80
state enemy_turn "Flare Dancer's core answers" in beat at 580 80
state enemy_act "Flare Dancer's core acts" in beat at 440 150
state beat_end "End of the beat" in beat at 580 150
state range_near "Near" in range at 760 80
state range_far "Far" in range at 900 80
state link_hp "Link's health (1 mark = 32/16 heart)" in link_state at 1080 80
