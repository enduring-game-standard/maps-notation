verb run_more_timer_clears "The core runs circles (the Flare Dancer has health to spare) is over" by world priority 99 in enemy at 2180 150
  take timer_run_more
  unless phase_run_more

verb run_last_timer_clears "The core runs circles (the Flare Dancer's last core) is over" by world priority 99 in enemy at 2180 290
  take timer_run_last
  unless phase_run_last

