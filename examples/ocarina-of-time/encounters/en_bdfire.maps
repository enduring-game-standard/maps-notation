verb link_heals "Link heals" by world priority 98 in link_state at 1080 500
  take link_heal
  take link_missing
  give link_hp

verb link_heal_overflows "Link is at full health" by world priority 98 in link_state at 1220 500
  take link_heal
  unless link_missing

verb magic_refills "Magic refills" by world priority 97 in link_state at 1080 570
  take magic_refill
  take magic_spent
  give magic

verb magic_refill_overflows "Magic is full" by world priority 97 in link_state at 1220 570
  take magic_refill
  unless magic_spent

verb link_hurt "Link loses health" by world priority 94 in link_state at 1080 640
  take link_dmg
  take link_hp
  give link_missing

verb link_hurt_overkill "Link has no health left to lose" by world priority 93 in link_state at 1220 640
  take link_dmg
  unless link_hp

verb fairy_revives_link "A bottled fairy revives Link" by world priority 90 in link_state at 1080 710
  need in_fight
  unless link_hp
  take has_fairy
  give 16 link_heal

verb link_fell "Link falls" by world priority 89 in outcomes at 1540 150
  need in_fight
  unless link_hp
  unless has_fairy
  give link_falls

verb link_deku_nut "Deku Nut thrown; on impact it spawns En_M_Fire1, a 200-radius flash cylinder carrying DMG_DEKU_NUT" by link in link_moves at 2360 80
  take link_turn
  need age_child
  need has_deku_nuts
  give swing_deku_nut
  give enemy_turn

verb link_deku_stick "Deku Stick swing (every swing direction is forced to a forward slash)" by link in link_moves at 2500 80
  take link_turn
  need age_child
  need has_deku_sticks
  need range_near
  give swing_deku_stick
  give enemy_turn

verb link_slingshot "Slingshot seed (child only: the projectile type is ARROW_SEED when not adult)" by link in link_moves at 2360 150
  take link_turn
  need age_child
  need has_slingshot
  give swing_slingshot
  give enemy_turn

verb link_explosive_1 "Bomb explosion (8 + rot.z high byte; the player spawns it with rot.z 0); AT_TYPE_ALL, so it also hurts Link" by link in link_moves at 2500 150
  take link_turn
  need age_child
  need has_bombs
  give swing_explosive
  give enemy_turn

verb link_boomerang "Boomerang" by link in link_moves at 2360 220
  take link_turn
  need age_child
  need has_boomerang
  give swing_boomerang
  give enemy_turn

verb link_slash_kokiri "Kokiri Sword slash (horizontal, vertical, thrust, combo finishers, and crouch stab fold in here; crouch stab sets no flags of its own and keeps the quads' last dmgFlags, src/overlays/actors/ovl_player_actor/z_player.c:8966)" by link in link_moves at 2500 220
  take link_turn
  need age_child
  need has_kokiri_sword
  need range_near
  give swing_slash_kokiri
  give enemy_turn

verb link_magic_fire "Din's Fire; collider damage starts at 1 and is rewritten each frame to actionTimer + 25 while expanding, then actionTimer" by link in link_moves at 2360 290
  take link_turn
  need age_child
  need has_dins_fire
  need has_magic
  take 12 magic
  give 12 magic_spent
  give swing_magic_fire
  give enemy_turn

verb link_shield_1 "Deku Shield raised: the shield quad is set as AT with DMG_SHIELD while shielding" by link in link_moves at 2500 290
  take link_turn
  need age_child
  need has_deku_shield
  need range_near
  give swing_shield
  give enemy_turn

verb link_shield_2 "Hylian Shield raised: the shield quad is set as AT with DMG_SHIELD while shielding" by link in link_moves at 2360 360
  take link_turn
  need age_child
  need has_hylian_shield
  need range_near
  give swing_shield
  give enemy_turn

verb link_spin_kokiri_1 "Kokiri Sword quick spin (stick rotation + B); En_M_Thunder carries the spin flags only when the magic meter is acquired and idle, at no cost; without it the swing hits with slash flags" by link in link_moves at 2500 360
  take link_turn
  need age_child
  need has_kokiri_sword
  need has_magic
  give swing_spin_kokiri
  give enemy_turn

verb link_spin_kokiri_2 "Kokiri Sword charged spin released below 85% charge (params 0x200 >> 8 = 2 magic, requested at 10% charge)" by link in link_moves at 2360 430
  take link_turn
  need age_child
  need has_kokiri_sword
  need has_magic
  take 2 magic
  give 2 magic_spent
  give swing_spin_kokiri
  give enemy_turn

verb link_jump_kokiri_1 "Kokiri Sword jump slash (Z-target + A)" by link in link_moves at 2500 430
  take link_turn
  need age_child
  need has_kokiri_sword
  need range_near
  give swing_jump_kokiri
  give enemy_turn

verb link_jump_kokiri_2 "Kokiri Sword great spin: charged spin released at or above 85% charge, En_M_Thunder switches to jump flags (2 magic)" by link in link_moves at 2360 500
  take link_turn
  need age_child
  need has_kokiri_sword
  need has_magic
  take 2 magic
  give 2 magic_spent
  give swing_jump_kokiri_self
  give enemy_turn

verb link_jump_master_3 "Deku Stick jump slash: the stick row of the melee table emits DMG_JUMP_MASTER, so a child gets Master Sword jump damage" by link in link_moves at 2500 500
  take link_turn
  need age_child
  need has_deku_sticks
  need range_near
  give swing_jump_master
  give enemy_turn

