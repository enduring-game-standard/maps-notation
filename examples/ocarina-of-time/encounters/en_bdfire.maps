verb fight_child_bottles "Fight as child Link: child bottles (1 hearts)" by link in setup at 120 360
  take choose_age
  give age_child
  give 16 link_hp
  give in_fight
  give 2 has_deku_nuts
  give has_kokiri_sword
  give has_deku_shield
