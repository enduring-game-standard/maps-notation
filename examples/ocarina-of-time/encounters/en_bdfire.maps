  give age_child
  give 16 link_hp
  give in_fight
  give 2 has_deku_nuts
  give has_kokiri_sword
  give has_deku_shield
  give has_deku_sticks
  give has_slingshot
  give has_boomerang
  give has_bombs
  give phase_breath
  give range_far
  give link_turn

