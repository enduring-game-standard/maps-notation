verb enemy_ready "King Dodongo's fire breath gets ready" by world priority 70 in enemy at 2040 150
  take enemy_turn
  give enemy_act

verb breath_step_1 "The flame washes over Link" by world priority 69 in enemy at 2180 150
  take enemy_act
  take phase_breath
  give phase_spent
  give incoming_flame
  give beat_end

verb spent_holds "The flame has died out: nothing changes" by world priority 68 in enemy at 2040 220
  take enemy_act
  need phase_spent
  give beat_end

verb flame_dodged "Fire breath: dodged" by world priority 60 in attacks at 3140 80
  take incoming_flame
  need link_dodge

verb flame_nayru "Fire breath: Nayru's Love holds" by world priority 60 in attacks at 3000 150
  take incoming_flame
  need status_nayru
  unless link_dodge

verb flame_lands "Fire breath hits Link" by world priority 60 in attacks at 3140 150
  take incoming_flame
  unless link_dodge
  unless status_nayru
  give 8 link_dmg
  give 5 status_burn
  unless status_burn

verb flame_lands_again "Fire breath hits Link again" by world priority 60 in attacks at 3000 220
  take incoming_flame
  unless link_dodge
  unless status_nayru
  give 8 link_dmg
  need status_burn

verb link_lowers_shield "Link lowers his shield" by world priority 50 in beat at 440 220
  need beat_end
  take link_guard

verb link_lowers_deku_shield "Link lowers the deku shield" by world priority 50 in beat at 580 220
  need beat_end
