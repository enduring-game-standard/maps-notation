maps 2
title "Ocarina of Time combat: Link vs King Dodongo's fire breath"

seat link "Link" color "#3a7d44"
group setup "setup"
group beat "beat"
group range "range"
group link_state "link state"
group outcomes "outcomes"
group gear "gear"
group enemy "enemy"
group link_moves "link moves"
group hits "hits"
group attacks "attacks"

state choose_age "Link sets out" marks 1 in setup at 120 80
state age_child "Link is a child" in setup at 260 80
state link_turn "Link's move" in beat at 440 80
state enemy_turn "King Dodongo's fire breath answers" in beat at 580 80
state enemy_act "King Dodongo's fire breath acts" in beat at 440 150
state beat_end "End of the beat" in beat at 580 150
state range_near "Near" in range at 760 80
state range_far "Far" in range at 900 80
state link_hp "Link's health (1 mark = 1/16 heart)" in link_state at 1080 80
state link_missing "Link's lost health" in link_state at 1220 80
state link_dmg "Damage to Link" in link_state at 1080 150
state link_heal "Healing for Link" in link_state at 1220 150
state magic "Magic (1 mark = 1 units)" in link_state at 1080 220
state magic_spent "Magic spent" in link_state at 1220 220
state magic_refill "Magic coming back" in link_state at 1080 290
state in_fight "The fight is on" in setup at 120 150
state link_wins "King Dodongo's fire breath defeated" ends "Link wins" in outcomes at 1400 80
state link_falls "Link falls" ends "Link falls" in outcomes at 1540 80
state link_withdraws "Link withdraws" ends "Link withdraws" in outcomes at 1400 150
state has_deku_nuts "Has deku nuts" in gear at 1720 80
state has_kokiri_sword "Has kokiri sword" in gear at 1860 80
state has_deku_shield "Has deku shield" in gear at 1720 150
state has_deku_sticks "Has deku sticks" in gear at 1860 150
state has_slingshot "Has slingshot" in gear at 1720 220
state has_boomerang "Has boomerang" in gear at 1860 220
state has_bombs "Has bombs" in gear at 1720 290
state has_magic "Has magic" in gear at 1860 290
state has_green_potion "Has green potion" in gear at 1720 360
state has_dins_fire "Has dins fire" in gear at 1860 360
state has_hylian_shield "Has hylian shield" in gear at 1720 430
state has_nayrus_love "Has nayrus love" in gear at 1860 430
state has_lens_of_truth "Has lens of truth" in gear at 1720 500
state has_fairy "Has fairy" in gear at 1860 500
state has_red_potion "Has red potion" in gear at 1720 570
state phase_breath "The flame rolls toward Link" in enemy at 2040 80
state phase_spent "The flame has died out" in enemy at 2180 80
state status_burn "Link: burn (beats left)" in link_state at 1220 290
state status_nayru "Link: nayru (beats left)" in link_state at 1080 360
state lens_on "Lens of Truth on" in link_state at 1220 360
state link_guard "Link holds up his shield" in link_state at 1080 430
state link_dodge "Link dodges" in link_state at 1220 430
state swing_deku_nut "Deku Nut flash on its way" in hits at 2680 80
state swing_deku_stick "Deku Stick on its way" in hits at 2680 150
state swing_slingshot "Slingshot seed on its way" in hits at 2680 220
state swing_explosive "Explosion on its way" in hits at 2680 290
state swing_boomerang "Boomerang on its way" in hits at 2680 360
state swing_slash_kokiri "Kokiri Sword slash on its way" in hits at 2680 430
state swing_magic_fire "Din's Fire on its way" in hits at 2680 500
state swing_shield "Shield on its way" in hits at 2820 570
state swing_spin_kokiri "Kokiri spin attack on its way" in hits at 2820 640
state swing_jump_kokiri "Kokiri jump attack on its way" in hits at 2680 780
state swing_jump_kokiri_self "Kokiri jump attack on its way" in hits at 2680 850
state swing_jump_master "Master Sword jump attack on its way" in hits at 2820 920
state guard_with_deku_shield "Shield up: deku shield" in link_state at 1220 710
state guard_with_hylian_shield "Shield up: hylian shield" in link_state at 1080 780
state incoming_flame "Fire breath incoming" in attacks at 3000 80
state tick_burn "Beat ends: burn checked" in beat at 440 360
state tick_nayru "Beat ends: nayru checked" in beat at 580 360
state burn_count "Link: burn: beats toward the next cost" in beat at 440 430
state lens_count "The Lens: beats toward the next cost" in beat at 580 640

verb fight_child_blade "Fight as child Link: child blade (1 hearts)" by link in setup at 260 150
