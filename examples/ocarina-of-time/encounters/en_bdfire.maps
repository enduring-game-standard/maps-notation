verb link_lens_on "Link looks through the Lens of Truth" by link in link_moves at 2500 850
  take link_turn
  unless lens_on
  need has_lens_of_truth
  need magic
  give lens_on
  give link_turn

verb link_lens_off "Link puts the Lens away" by link in link_moves at 2360 920
  take link_turn
