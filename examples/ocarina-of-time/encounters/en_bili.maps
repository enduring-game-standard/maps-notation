verb electrify_timer_clears "Biri crackles after touching Link is over" by world priority 100 in enemy at 2040 220
  take timer_electrify
  unless phase_electrify

verb electrify_dying_timer_clears "A slashed Biri crackles before it dies is over" by world priority 100 in enemy at 2180 290
  take timer_electrify_dying
  unless phase_electrify_dying

verb flee_timer_clears "Biri floats away above Link is over" by world priority 100 in enemy at 2180 430
  take timer_flee
  unless phase_flee

verb stunned_timer_clears "Biri is stunned and sinks is over" by world priority 100 in enemy at 2180 570
  take timer_stunned
  unless phase_stunned

verb spawned_timer_clears "Biri pops out of a Bari is over" by world priority 100 in enemy at 2040 710
  take timer_spawned
  unless phase_spawned

