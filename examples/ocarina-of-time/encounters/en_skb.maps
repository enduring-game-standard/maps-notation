maps 2
title "Ocarina of Time combat: Link vs Stalchild"

seat link "Link" color "#3a7d44"
group setup "setup"
group beat "beat"
group range "range"
group link_state "link state"
group outcomes "outcomes"
group gear "gear"
group enemy "enemy"
group enemy_health "enemy health"
group link_moves "link moves"
group hits "hits"
group attacks "attacks"

state choose_age "Link sets out" marks 1 in setup at 120 80
state age_child "Link is a child" in setup at 260 80
state choose_variant "Which Stalchild" in setup at 120 150
