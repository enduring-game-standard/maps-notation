  need status_nayru
  unless link_dodge

verb swallow_lands "Like Like swallows Link hits Link" by world priority 60 in attacks at 3460 150
  take incoming_swallow
  unless link_dodge
  unless status_nayru
  unless has_double_defense
  give 2 link_dmg
  give steal_swallow

verb swallow_lands_dd "Like Like swallows Link hits Link" by world priority 60 in attacks at 3320 220
  take incoming_swallow
  unless link_dodge
  unless status_nayru
  need has_double_defense
  give link_dmg
  give steal_swallow

verb swallow_takes_deku_shield "Like Like swallows Link takes the deku shield" by world priority 62 in attacks at 3320 290
  need steal_swallow
  take has_deku_shield

verb swallow_takes_hylian_shield "Like Like swallows Link takes the hylian shield" by world priority 61 in attacks at 3460 290
  need steal_swallow
  take has_hylian_shield

verb swallow_takes_goron_tunic "Like Like swallows Link takes the goron tunic" by world priority 60 in attacks at 3320 360
  need steal_swallow
  take has_goron_tunic

verb swallow_lets_go "Like Like swallows Link lets go" by world priority 59 in attacks at 3460 360
  take steal_swallow

verb link_lowers_shield "Link lowers his shield" by world priority 50 in beat at 440 220
  need beat_end
  take link_guard

verb link_lowers_deku_shield "Link lowers the deku shield" by world priority 50 in beat at 580 220
  need beat_end
  take guard_with_deku_shield

verb link_lowers_hylian_shield "Link lowers the hylian shield" by world priority 50 in beat at 440 290
  need beat_end
  take guard_with_hylian_shield

verb link_lowers_mirror_shield "Link lowers the mirror shield" by world priority 50 in beat at 580 290
  need beat_end
  take guard_with_mirror_shield

verb link_lands "Link lands from his dodge" by world priority 50 in beat at 440 360
  need beat_end
  take link_dodge

verb nayru_ticks "Link: nayru wears on" by world priority 48 in beat at 440 430
  take beat_end
  take status_nayru
  give tick_nayru

verb nayru_idle "Link: no nayru" by world priority 48 in beat at 580 430
  take beat_end
  unless status_nayru
  give tick_nayru

verb lens_ticks "The Lens wears on" by world priority 47 in beat at 580 500
  take tick_nayru
  need lens_on
  need magic
  unless 3 lens_count
  give lens_count
  give link_turn

verb lens_costs "The Lens takes its toll" by world priority 47 in beat at 440 570
  take tick_nayru
  need lens_on
  need magic
  take 3 lens_count
  give link_turn
  take magic
  give magic_spent

verb lens_fades "The Lens runs out of magic" by world priority 47 in beat at 580 570
  take tick_nayru
  take lens_on
  unless magic
  give link_turn

verb lens_idle "The Lens is off" by world priority 47 in beat at 440 640
  take tick_nayru
  unless lens_on
  give link_turn

verb lens_count_clears "The Lens count resets" by world priority 99 in beat at 580 640
  take lens_count
  unless lens_on
