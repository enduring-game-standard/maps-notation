verb down_blue_timer_clears "Blue Bubble is down, flame out is over" by world priority 99 in enemy at 2040 220
  take timer_down_blue
  unless phase_down_blue

verb stunned_blue_timer_clears "Blue Bubble is stunned, flame out is over" by world priority 99 in enemy at 2180 290
  take timer_stunned_blue
  unless phase_stunned_blue

