  unless phase_hurt

verb flee_timer_clears "Larva runs away from Link is over" by world priority 100 in enemy at 2180 920
  take timer_flee
  unless phase_flee

verb stunned_timer_clears "Larva is stunned by a Deku Nut is over" by world priority 100 in enemy at 2040 1060
  take timer_stunned
  unless phase_stunned

