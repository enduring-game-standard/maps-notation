verb wait_rising_timer_clears "Tailpasaran rises out of the floor is over" by world priority 100 in enemy at 2180 150
  take timer_wait_rising
  unless phase_wait_rising

verb hover_timer_clears "Tailpasaran hovers above Link is over" by world priority 100 in enemy at 2040 290
  take timer_hover
  unless phase_hover

verb attack_timer_clears "Tailpasaran swoops at Link is over" by world priority 100 in enemy at 2180 360
