verb wait_timer_clears "No Poe: waiting to rise near Link is over" by world priority 100 in enemy at 2040 150
  take timer_wait
  unless phase_wait

verb wait_c_timer_clears "No Poe: waiting to rise near Link (Big Poe already taken) is over" by world priority 100 in enemy at 2180 220
  take timer_wait_c
  unless phase_wait_c

verb circle_timer_clears "Poe circles Link, dropping flames is over" by world priority 100 in enemy at 2180 430
