verb eye_wait_timer_clears "The eye is shut and recovering is over" by world priority 99 in enemy at 2180 150
  take timer_eye_wait
  unless phase_eye_wait

verb eye_open_timer_clears "The eye is open and its flame flies at Link is over" by world priority 99 in enemy at 2040 290
  take timer_eye_open
  unless phase_eye_open

verb eye_chase_timer_clears "The eye has shut; its flame chases Link is over" by world priority 99 in enemy at 2040 430
  take timer_eye_chase
  unless phase_eye_chase

verb flame_out_timer_clears "The eye is destroyed; its flame still chases Link is over" by world priority 99 in enemy at 2180 500
  take timer_flame_out
  unless phase_flame_out

verb drop_timer_clears "Dampé's flame burns where it fell is over" by world priority 99 in enemy at 2040 640
  take timer_drop
  unless phase_drop

