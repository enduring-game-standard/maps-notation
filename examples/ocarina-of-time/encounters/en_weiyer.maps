  need phase_stunned
  take timer_stunned
  give enemy_act

verb stunned_step_1 "Stinger shakes off the stun" by world priority 69 in enemy at 2180 1480
  take enemy_act
  take phase_stunned
  give phase_swim
  unless timer_stunned
  give beat_end

verb stunned_holds "Stinger is stunned: nothing changes" by world priority 68 in enemy at 2040 1550
  take enemy_act
  need phase_stunned
  give beat_end

verb sting_blocked_deku_shield "Stinger sting: blocked by the deku shield" by world priority 60 in attacks at 3460 80
  take incoming_sting
  need guard_with_deku_shield

verb sting_blocked_hylian_shield "Stinger sting: blocked by the hylian shield" by world priority 60 in attacks at 3320 150
  take incoming_sting
  need guard_with_hylian_shield

verb sting_blocked_mirror_shield "Stinger sting: blocked by the mirror shield" by world priority 60 in attacks at 3460 150
  take incoming_sting
  need guard_with_mirror_shield

verb sting_dodged "Stinger sting: dodged" by world priority 60 in attacks at 3320 220
  take incoming_sting
  need link_dodge
  unless link_guard

verb sting_nayru "Stinger sting: Nayru's Love holds" by world priority 60 in attacks at 3460 220
  take incoming_sting
  need status_nayru
  unless link_guard
  unless link_dodge

verb sting_lands "Stinger sting hits Link" by world priority 60 in attacks at 3320 290
  take incoming_sting
  unless link_guard
  unless link_dodge
  unless status_nayru
  unless has_double_defense
  give 2 link_dmg

verb sting_lands_dd "Stinger sting hits Link" by world priority 60 in attacks at 3460 290
  take incoming_sting
  unless link_guard
  unless link_dodge
  unless status_nayru
  need has_double_defense
  give link_dmg

verb link_lowers_shield "Link lowers his shield" by world priority 50 in beat at 440 220
  need beat_end
  take link_guard

verb link_lowers_deku_shield "Link lowers the deku shield" by world priority 50 in beat at 580 220
  need beat_end
  take guard_with_deku_shield

verb link_lowers_hylian_shield "Link lowers the hylian shield" by world priority 50 in beat at 440 290
  need beat_end
  take guard_with_hylian_shield

verb link_lowers_mirror_shield "Link lowers the mirror shield" by world priority 50 in beat at 580 290
  need beat_end
  take guard_with_mirror_shield

verb link_lands "Link lands from his dodge" by world priority 50 in beat at 440 360
  need beat_end
  take link_dodge

verb nayru_ticks "Link: nayru wears on" by world priority 48 in beat at 440 430
  take beat_end
  take status_nayru
  give tick_nayru

verb nayru_idle "Link: no nayru" by world priority 48 in beat at 580 430
  take beat_end
  unless status_nayru
  give tick_nayru

verb lens_ticks "The Lens wears on" by world priority 47 in beat at 580 500
  take tick_nayru
  need lens_on
  need magic
  unless 3 lens_count
  give lens_count
  give link_turn

verb lens_costs "The Lens takes its toll" by world priority 47 in beat at 440 570
  take tick_nayru
  need lens_on
  need magic
  take 3 lens_count
  give link_turn
  take magic
  give magic_spent

verb lens_fades "The Lens runs out of magic" by world priority 47 in beat at 580 570
  take tick_nayru
  take lens_on
  unless magic
  give link_turn

verb lens_idle "The Lens is off" by world priority 47 in beat at 440 640
  take tick_nayru
  unless lens_on
  give link_turn

verb lens_count_clears "The Lens count resets" by world priority 100 in beat at 580 640
  take lens_count
  unless lens_on
