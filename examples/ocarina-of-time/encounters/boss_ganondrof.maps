verb paint_approach_timer_clears "Phantom Ganon gallops up inside a painting is over" by world priority 100 in enemy at 2040 150
  take timer_paint_approach
  unless phase_paint_approach

verb paint_emerge_timer_clears "Phantom Ganon rides out of a painting is over" by world priority 100 in enemy at 2180 220
  take timer_paint_emerge
  unless phase_paint_emerge

verb paint_leap_timer_clears "Phantom Ganon leaps across the room, spear raised is over" by world priority 100 in enemy at 2040 360
